# Public service overrides for local, staging, or preview builds.
# Leave unset to use the production URLs in src/config/services.json.
VITE_API_URL=http://localhost:3000
# VITE_WEBSITE_URL=https://staging.blimy.dev
# VITE_EXTENSIONS_CDN_BASE_URL=https://staging.blimy.dev/extensions
# VITE_SKILLS_REGISTRY_URL=https://staging.blimy.dev/skills/index.json
# VITE_UPDATE_BASE_URL=https://staging.blimy.dev

# Supabase project used for sign in and hosted AI. Both are required; the app
# shows a clear message instead of starting when either is missing.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
