{
  "$schema": "https://raw.githubusercontent.com/antan2002/blimy/main/extensions/schema/extension.schema.json",
  "id": "blimy.database.duckdb",
  "name": "DuckDB",
  "displayName": "DuckDB Provider",
  "version": "1.0.0",
  "description": "DuckDB database browser and query provider.",
  "publisher": "antan2002",
  "categories": ["Database"],
  "activationEvents": ["onDatabase:duckdb"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antan2002/blimy/tree/master/extensions/official/duckdb"
  },
  "icon": "icon.svg",
  "databases": [
    {
      "id": "duckdb",
      "label": "DuckDB",
      "isFileBased": true,
      "protocolVersion": 1,
      "fileExtensions": [".duckdb", ".duck"],
      "sidecar": {
        "darwin-arm64": "bin/blimy-db-duckdb",
        "darwin-x64": "bin/blimy-db-duckdb",
        "linux-arm64": "bin/blimy-db-duckdb",
        "linux-x64": "bin/blimy-db-duckdb",
        "win32-x64": "bin/blimy-db-duckdb.exe"
      }
    }
  ]
}
