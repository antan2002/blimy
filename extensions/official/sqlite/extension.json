{
  "$schema": "https://Blimy.dev/schemas/extension.json",
  "id": "Blimy.database.sqlite",
  "name": "SQLite",
  "displayName": "SQLite Provider",
  "version": "1.0.0",
  "description": "SQLite database browser and query provider.",
  "publisher": "Blimy",
  "categories": ["Database"],
  "activationEvents": ["onDatabase:sqlite"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antan2002/blimy/tree/master/extensions/official/sqlite"
  },
  "icon": "icon.svg",
  "databases": [
    {
      "id": "sqlite",
      "label": "SQLite",
      "isFileBased": true,
      "protocolVersion": 1,
      "fileExtensions": [".sqlite", ".db", ".sqlite3"],
      "sidecar": {
        "darwin-arm64": "bin/Blimy-db-sqlite",
        "darwin-x64": "bin/Blimy-db-sqlite",
        "linux-arm64": "bin/Blimy-db-sqlite",
        "linux-x64": "bin/Blimy-db-sqlite",
        "win32-x64": "bin/Blimy-db-sqlite.exe"
      }
    }
  ]
}
