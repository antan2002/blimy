{
  "$schema": "https://blimy.dev/schemas/extension.json",
  "id": "blimy.python",
  "name": "Python",
  "displayName": "Python",
  "version": "1.0.0",
  "description": "Python language support with LSP and tooling",
  "publisher": "Blimy",
  "categories": ["Language"],
  "languages": [
    {
      "id": "python",
      "extensions": [".py", ".pyw", ".pyi", ".ipy"],
      "aliases": ["Python", "python3", "IPython"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "pyright",
      "runtime": "bun",
      "package": "pyright",
      "args": ["--stdio"]
    },
    "formatter": {
      "name": "black",
      "runtime": "python",
      "package": "black",
      "args": ["--stdin-filename", "${file}", "-"]
    },
    "linter": {
      "name": "ruff",
      "runtime": "python",
      "package": "ruff",
      "args": ["check", "--stdin-filename", "${file}", "--output-format", "json", "-"]
    }
  }
}
