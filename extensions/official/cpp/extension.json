{
  "$schema": "https://raw.githubusercontent.com/antan2002/blimy/main/extensions/schema/extension.schema.json",
  "id": "blimy.cpp",
  "name": "C++",
  "displayName": "C++",
  "version": "1.0.0",
  "description": "C++ language support with LSP",
  "publisher": "antan2002",
  "categories": ["Language"],
  "languages": [
    {
      "id": "cpp",
      "extensions": [".cpp", ".cc", ".cxx", ".hpp", ".hh", ".hxx"],
      "aliases": ["C++", "cpp"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "clangd",
      "runtime": "binary",
      "args": ["--background-index"]
    }
  }
}
