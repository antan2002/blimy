{
  "$schema": "https://raw.githubusercontent.com/antan2002/blimy/main/extensions/schema/extension.schema.json",
  "id": "blimy.ruby",
  "name": "Ruby",
  "displayName": "Ruby",
  "version": "1.0.0",
  "description": "Ruby language support (Ruby, ERB and common Rails templates)",
  "publisher": "antan2002",
  "categories": ["Language"],
  "languages": [
    {
      "id": "ruby",
      "extensions": [
        ".rb",
        ".rbw",
        ".erb",
        ".rake",
        ".gemspec",
        ".ru",
        ".builder",
        ".jbuilder",
        ".rxml",
        ".rjs",
        ".rabl",
        ".thor",
        ".podspec",
        ".arb"
      ],
      "aliases": ["Ruby", "rb", "erb"],
      "filenames": [
        "Rakefile",
        "Gemfile",
        "Gemfile.lock",
        "Guardfile",
        "Capfile",
        "Appraisals",
        "Berksfile",
        "Brewfile",
        "Cheffile",
        "Dangerfile",
        "Fastfile",
        "Podfile",
        "Rantfile",
        "Thorfile",
        "Vagrantfile",
        "Puppetfile"
      ]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "solargraph",
      "runtime": "binary",
      "args": ["stdio"]
    }
  }
}
