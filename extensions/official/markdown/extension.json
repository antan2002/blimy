{
  "$schema": "https://raw.githubusercontent.com/antan2002/blimy/main/extensions/schema/extension.schema.json",
  "id": "blimy.markdown",
  "name": "Markdown",
  "displayName": "Markdown",
  "version": "1.0.0",
  "description": "Markdown language support with LSP and formatting",
  "publisher": "antan2002",
  "categories": ["Language"],
  "languages": [
    {
      "id": "markdown",
      "extensions": [".md", ".markdown", ".mdx"],
      "aliases": ["Markdown", "md"]
    },
    {
      "id": "rmarkdown",
      "extensions": [".Rmd", ".rmd"],
      "aliases": ["R Markdown", "Rmd", "rmarkdown"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "marksman",
      "runtime": "binary",
      "downloadUrl": "https://github.com/antan2002/blimy/extensions/markdown/markdown-${os}-${arch}.tar.gz",
      "args": ["server"]
    },
    "formatter": {
      "name": "prettier",
      "runtime": "bun",
      "package": "prettier",
      "args": ["--stdin-filepath", "${file}"]
    }
  }
}
