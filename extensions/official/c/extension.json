{
  "$schema": "https://raw.githubusercontent.com/antan2002/blimy/main/extensions/schema/extension.schema.json",
  "id": "blimy.c",
  "name": "C",
  "displayName": "C",
  "version": "1.0.0",
  "description": "C language support with LSP",
  "publisher": "antan2002",
  "categories": ["Language"],
  "languages": [
    {
      "id": "c",
      "extensions": [".c", ".h"],
      "aliases": ["C"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "clangd",
      "runtime": "binary",
      "args": ["--background-index"]
    }
  }
}
