{
  "$schema": "https://Blimy.dev/schemas/extension.json",
  "id": "Blimy.html",
  "name": "HTML",
  "displayName": "HTML",
  "version": "1.0.0",
  "description": "HTML language support with LSP and formatting",
  "publisher": "Blimy",
  "categories": ["Language"],
  "languages": [
    {
      "id": "html",
      "extensions": [".html", ".htm", ".xhtml"],
      "aliases": ["HTML"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "vscode-html-language-server",
      "runtime": "bun",
      "package": "vscode-langservers-extracted",
      "args": ["--stdio"]
    },
    "formatter": {
      "name": "prettier",
      "runtime": "bun",
      "package": "prettier",
      "args": ["--stdin-filepath", "${file}"]
    }
  }
}
