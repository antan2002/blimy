{
  "$schema": "https://Blimy.dev/schemas/extension.json",
  "id": "Blimy.go",
  "name": "Go",
  "displayName": "Go",
  "version": "1.0.0",
  "description": "Go language support with LSP and tooling",
  "publisher": "Blimy",
  "categories": ["Language"],
  "languages": [
    {
      "id": "go",
      "extensions": [".go"],
      "aliases": ["Go", "golang"],
      "filenames": ["go.mod", "go.sum", "go.work"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "gopls",
      "runtime": "go",
      "package": "golang.org/x/tools/gopls",
      "args": ["serve"]
    },
    "linter": {
      "name": "golangci-lint",
      "runtime": "go",
      "package": "github.com/golangci/golangci-lint/cmd/golangci-lint",
      "args": ["run", "--out-format", "json"]
    },
    "formatter": {
      "name": "gofumpt",
      "runtime": "go",
      "package": "mvdan.cc/gofumpt",
      "args": []
    }
  }
}
