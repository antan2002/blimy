{
  "$schema": "https://raw.githubusercontent.com/antan2002/blimy/main/extensions/schema/extension.schema.json",
  "id": "blimy.scala",
  "name": "Scala",
  "displayName": "Scala",
  "version": "1.0.0",
  "description": "Scala language support with LSP",
  "publisher": "antan2002",
  "categories": ["Language"],
  "languages": [
    {
      "id": "scala",
      "extensions": [".scala", ".sc"],
      "aliases": ["Scala"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "metals",
      "runtime": "system",
      "args": []
    }
  }
}
