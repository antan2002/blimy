{
  "$schema": "https://blimy.dev/schemas/extension.json",
  "id": "blimy.ocaml",
  "name": "OCaml",
  "displayName": "OCaml",
  "version": "1.0.0",
  "description": "OCaml language support with LSP",
  "publisher": "Blimy",
  "categories": ["Language"],
  "languages": [
    {
      "id": "ocaml",
      "extensions": [".ml", ".mli"],
      "aliases": ["OCaml"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "ocamllsp",
      "runtime": "system",
      "args": []
    }
  }
}
