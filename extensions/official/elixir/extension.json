{
  "$schema": "https://raw.githubusercontent.com/antan2002/blimy/main/extensions/schema/extension.schema.json",
  "id": "blimy.elixir",
  "name": "Elixir",
  "displayName": "Elixir",
  "version": "1.0.0",
  "description": "Elixir language support with LSP",
  "publisher": "antan2002",
  "categories": ["Language"],
  "languages": [
    {
      "id": "elixir",
      "extensions": [".ex", ".exs"],
      "aliases": ["Elixir"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "elixir-ls",
      "runtime": "binary",
      "args": []
    }
  }
}
