{
  "$schema": "https://Blimy.dev/schemas/extension.json",
  "id": "Blimy.database.mongodb",
  "name": "MongoDB",
  "displayName": "MongoDB Provider",
  "version": "1.0.0",
  "description": "MongoDB connection, collection, and document provider.",
  "publisher": "Blimy",
  "categories": ["Database"],
  "activationEvents": ["onDatabase:mongodb"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/antan2002/blimy/tree/master/extensions/official/mongodb"
  },
  "icon": "icon.svg",
  "databases": [
    {
      "id": "mongodb",
      "label": "MongoDB",
      "isFileBased": false,
      "protocolVersion": 1,
      "defaultPort": 27017,
      "sidecar": {
        "darwin-arm64": "bin/Blimy-db-mongodb",
        "darwin-x64": "bin/Blimy-db-mongodb",
        "linux-arm64": "bin/Blimy-db-mongodb",
        "linux-x64": "bin/Blimy-db-mongodb",
        "win32-x64": "bin/Blimy-db-mongodb.exe"
      }
    }
  ]
}
