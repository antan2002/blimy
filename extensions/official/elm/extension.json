{
  "$schema": "https://Blimy.dev/schemas/extension.json",
  "id": "Blimy.elm",
  "name": "Elm",
  "displayName": "Elm",
  "version": "1.0.0",
  "description": "Elm language support with LSP",
  "publisher": "Blimy",
  "categories": ["Language"],
  "languages": [
    {
      "id": "elm",
      "extensions": [".elm"],
      "aliases": ["Elm"]
    }
  ],
  "capabilities": {
    "lsp": {
      "name": "elm-language-server",
      "runtime": "binary",
      "args": ["--stdio"]
    }
  }
}
